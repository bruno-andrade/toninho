# Painel administrativo — login único compartilhado (ver docs/ADMIN_SERVER_ACTIONS.md, seção 1)
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão do admin — gere um valor aleatório longo
# (ex: openssl rand -base64 32) e nunca reutilize entre ambientes.
ADMIN_SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Neon Postgres (Vercel Marketplace, plano Free) — provisionado via `vercel integration add neon`.
# Não defina manualmente: rode `vercel env pull` para baixar os valores reais do projeto.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (fotos de carros e das solicitações de venda) — store "autoninho-photos",
# criado via `vercel blob create-store`. Também baixado por `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
